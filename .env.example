# Root environment for My Story Marker. Copy to `.env` and fill in only what you need.
# Placeholders only: never commit a real value. Backend-specific settings (stores, embedder,
# Claude Code CLI, effort per role) are in backend/.env.example.
#
# Model calls go through the Claude Code CLI under your own login: no Anthropic API key.

# --- Authoritative story bible (spec 004 D1) -------------------------------------------
HARNESS_DB=data/harness.sqlite

# --- Model per role (plan 004: Haiku 4.5 for every role) --------------------------------
MODEL_INTERVIEWER=claude-haiku-4-5
MODEL_PLANNER=claude-haiku-4-5
MODEL_WRITER=claude-haiku-4-5
MODEL_STYLE_EDITOR=claude-haiku-4-5
MODEL_AUDITOR=claude-haiku-4-5
MODEL_JUDGE=claude-haiku-4-5
MODEL_CANONISER=claude-haiku-4-5

# --- Langfuse (observability, block B6) ------------------------------------------------
# Leave the keys empty to run with tracing off (no-op observer).
LANGFUSE_ENABLED=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Playwright MCP (optional, local machine only) -------------------------------------
# Only if the Playwright browser cache lacks the revision @playwright/mcp expects.
# PLAYWRIGHT_MCP_EXECUTABLE_PATH=
