.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Local configuration. `backend/.env.example` is committed; the real one is not.
backend/.env

# Node
node_modules/
dist/

# The authoritative database (spec 005, HARNESS_DB). A source, but local: never committed.
data/
