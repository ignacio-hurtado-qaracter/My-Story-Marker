# The derived index, the embedding-model cache and the backend's operational records.
# Nothing under `.index/` is a store: it is not governed by Figure 3 and no agent reads it
# (architecture.md, "Storage layout"; spec 001 Decision R2-1).
.index/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Local configuration. `.env.example` files are committed; the real ones never are, at any
# level (the root `.env.example` says "copy to `.env`" and holds the Langfuse keys' slots;
# security report SEC-02).
.env
.env.*
!.env.example

# Node
node_modules/
dist/

# Playwright MCP snapshots
.playwright-mcp/

# The authoritative database (spec 005, HARNESS_DB). A source, but local: never committed.
data/

# Claude Code hook logs (spec 009): the policy guard appends its decisions here.
.claude/hooks/*.log
