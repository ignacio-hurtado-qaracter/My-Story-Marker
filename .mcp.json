{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ]
    },
    "story-maker": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "backend", "python", "-m", "app.mcp_server"],
      "env": {
        "HARNESS_DB": "data/harness.sqlite"
      }
    }
  }
}
