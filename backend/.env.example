# Copy to `backend/.env` and edit. `.env` is git-ignored; this file is not.
#
# Nothing here is a secret, and nothing here ever should be. Model calls go through the
# Claude Code CLI (`claude -p`) under your own Claude Code login (spec FR-LLM-01, decision
# R3-1). No Anthropic API key is used: the backend strips ANTHROPIC_API_KEY from the CLI's
# environment even if your shell has one, so do not add one here.

# --- Stores (FR-STORE-01) ----------------------------------------------------------------
# The directory holding canon/ cast/ structure/ scenes/ manuscript/ ledger/.
# The backend refuses to start if canon/project.md is missing.
STORY_ROOT=../story

# --- Derived index (FR-IDX-01) -----------------------------------------------------------
# Outside the tree, never committed. Defaults to $STORY_ROOT/.index/index.sqlite.
# STORY_INDEX=../story/.index/index.sqlite

# --- Embedder (FR-EMB) -------------------------------------------------------------------
# Only 384-d models are accepted, so the vec0 schema never changes.
# For prose written in Spanish, switch to the multilingual 384-d MiniLM *before* the first
# rebuild and you avoid a forced re-index later (spec Decision R2-3):
#   EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBED_FALLBACK_MODEL=BAAI/bge-small-en-v1.5
# EMBED_CACHE_DIR=../story/.index/models
# EMBED_OFFLINE=0

# --- Model per role (FR-LLM-03, Decision R2-4) -------------------------------------------
# Default for every role is claude-haiku-4-5. Raise one role when a live run shows it
# missing things; raising the default is a spec change, not a configuration change.
# MODEL_WRITER=claude-haiku-4-5
# MODEL_STYLE_EDITOR=claude-haiku-4-5
# MODEL_AUDITOR=claude-haiku-4-5
# MODEL_CANONISER=claude-haiku-4-5
# MODEL_ARCHITECT=claude-haiku-4-5
# MODEL_WORLD_BUILDER=claude-haiku-4-5

# Reasoning effort per role, passed to the CLI as --effort (low, medium, high, xhigh, max).
# Unset means the CLI default. (Wired at plan step 15.)
# EFFORT_AUDITOR=medium
# EFFORT_CANONISER=medium

# --- Turn (FR-AGENT-02, Decision R2-8) ---------------------------------------------------
# A revision that rewrites more than this share of the draft's sentences is rejected:
# `revise` fixes flagged spans, it does not regenerate the scene.
# TURN_REVISE_MAX_CHANGED_RATIO=0.35
