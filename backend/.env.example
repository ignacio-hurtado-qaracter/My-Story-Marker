# Copy to `backend/.env` and edit. `.env` is git-ignored; this file is not.
#
# Nothing here is a secret, and nothing here ever should be. Model calls go through the
# Claude Code CLI (`claude -p`) under your own Claude Code login (spec FR-LLM-01, decision
# R3-1). No Anthropic API key is used: the backend strips ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN from the CLI's environment even if your shell has them, so do not add
# either here.

# --- Stores (FR-STORE-01) ----------------------------------------------------------------
# The directory holding canon/ cast/ structure/ scenes/ manuscript/ ledger/.
# The backend refuses to start if canon/project.md is missing.
STORY_ROOT=../story

# --- Derived index (FR-IDX-01) -----------------------------------------------------------
# Outside the tree, never committed. Defaults to $STORY_ROOT/.index/index.sqlite.
# STORY_INDEX=../story/.index/index.sqlite

# --- Embedder (FR-EMB) -------------------------------------------------------------------
# Only 384-d models are accepted, so the vec0 schema never changes.
# For prose written in Spanish, switch to the multilingual 384-d MiniLM *before* the first
# rebuild and you avoid a forced re-index later (spec Decision R2-3):
#   EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBED_FALLBACK_MODEL=BAAI/bge-small-en-v1.5
# EMBED_CACHE_DIR=../story/.index/models
# EMBED_OFFLINE=0

# --- Model per role (FR-LLM-03, Decision R2-4) -------------------------------------------
# Default for every role is claude-haiku-4-5. Raise one role when a live run shows it
# missing things; raising the default is a spec change, not a configuration change.
# MODEL_WRITER=claude-haiku-4-5
# MODEL_STYLE_EDITOR=claude-haiku-4-5
# MODEL_AUDITOR=claude-haiku-4-5
# MODEL_CANONISER=claude-haiku-4-5
# MODEL_ARCHITECT=claude-haiku-4-5
# MODEL_WORLD_BUILDER=claude-haiku-4-5

# Reasoning effort per role, passed to the CLI as --effort. Exactly one of: low, medium,
# high, xhigh, max; anything else is a startup error. Unset or empty means the flag is not
# passed and the CLI's own default applies.
# EFFORT_WRITER=
# EFFORT_STYLE_EDITOR=
# EFFORT_AUDITOR=medium
# EFFORT_CANONISER=medium
# EFFORT_ARCHITECT=
# EFFORT_WORLD_BUILDER=

# --- Claude Code CLI (FR-LLM-01, FR-LLM-08) ----------------------------------------------
# The native `claude` executable. Unset: found on PATH. On Windows the npm shim
# (`...\npm\claude.CMD`) is resolved to the `claude.exe` it forwards to and is never run;
# set this only if that lookup fails. Must be logged in with `claude` beforehand.
# CLAUDE_CLI=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
# Seconds one model call may take before it is killed and retried once (max 3600).
# CLAUDE_TIMEOUT_SECONDS=600

# --- Turn (FR-AGENT-02, Decision R2-8) ---------------------------------------------------
# A revision that rewrites more than this share of the draft's sentences is rejected:
# `revise` fixes flagged spans, it does not regenerate the scene.
# TURN_REVISE_MAX_CHANGED_RATIO=0.35

# --- Login (spec 018, X03) ----------------------------------------------------------------
# Secret that signs session tokens (JWT HS256), at least 32 bytes. Unset: a random one per
# process, with a warning (sessions end when the backend stops). Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# 1 (default): the reader and interview API need `Authorization: Bearer <token>`.
# 0: a request without a token acts as the built-in `local` owner (local demo, visual check).
AUTH_REQUIRED=1
# Email of a registered user who owns what the local CLI generates and whose novels the MCP
# server (stdio) serves. Unset: the built-in `local` owner. Read from the process
# environment only (export it, or put it in the MCP client's `env`), not from this file.
# STORY_MAKER_USER=
